# 复制为 .env 后按需填写（.env 不入库）
# 服务基础
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://aih:aih@localhost:5433/ai_asset_hub

# 会话（SESSION_SECRET 必填：>=32 字符随机串）
SESSION_SECRET=
SESSION_TTL_HOURS=8

# 下载限流（可选——默认 60 次/分钟·IP）
# DOWNLOAD_RATE_LIMIT_WINDOW_MS=60000
# DOWNLOAD_RATE_LIMIT_MAX=60

# label 定义总数上限（可选——默认 100）
# LABEL_MAX_DEFINITIONS=100

# 注册与准入
REGISTRATION_ENABLED=false
ACCESS_POLICY=open

# 对象存储（M1 Local 实现；S3 后置 M3）
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# 资产包校验上限（可选——数值真源 = 服务端 config/env.ts；单位 = 字节）
# 默认：总包 100MiB / 单文件 10MiB / 文件数 100
# ASSET_PACKAGE_MAX_BYTES=104857600
# ASSET_FILE_MAX_BYTES=10485760
# ASSET_MAX_FILES=100

# LDAP 企业通道（默认关闭）
LDAP_ENABLED=false
LDAP_URLS=
LDAP_BIND_MODE=auto
LDAP_USER_BASE=
LDAP_USER_ID_ATTR=sAMAccountName
LDAP_TIMEOUT_MS=5000

# Origin 白名单（认证面 + 业务面同源守卫共用；逗号分隔；空 = 仅 PUBLIC_BASE_URL 同源）
# dev 前端独立端口时必须填，否则 cookie 写请求 403（07 §4 `auth.csrf_failed`）
AUTH_TRUSTED_ORIGINS=

# 种子管理员（可选：设置则 db:seed 建 SUPER_ADMIN）
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
# 逃生管理员合成邮箱（缺省 admin@local.test —— 目录取不到邮箱时的唯一合成点）
# 注意：本项 schema 为 email 格式，**留空会拒绝启动**（勿取消注释后置空）
# SEED_ADMIN_EMAIL=admin@local.test

# 对外基址（Device Flow verificationUri / 回调地址推导）
PUBLIC_BASE_URL=http://localhost:3000

# 外部身份源（M4c-3 外部身份源接入；**默认全部关闭** ⇒ 独立部署零影响）
# 企业 IdP = Microsoft Entra ID（原 Azure AD）。任一通道 ENABLED=true 但缺 CLIENT_ID/SECRET ⇒ 拒绝启动。
ENTRA_ENABLED=false
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# 租户 ID：ENTRA_ENABLED=true 时**必填**（官方缺省 "common" 会放行任何 Microsoft 账号 ⇒ 必须收紧本租户）
ENTRA_TENANT_ID=
# 社交三通道
SOCIAL_GOOGLE_ENABLED=false
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_GITHUB_ENABLED=false
SOCIAL_GITHUB_CLIENT_ID=
SOCIAL_GITHUB_CLIENT_SECRET=
SOCIAL_WECHAT_ENABLED=false
SOCIAL_WECHAT_CLIENT_ID=
SOCIAL_WECHAT_CLIENT_SECRET=
