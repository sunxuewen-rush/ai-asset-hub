# 复制为 .env 后按需填写（.env 不入库）
# 服务基础
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://aih:aih@localhost:5433/ai_asset_hub

# 会话（SESSION_SECRET 必填：>=32 字符随机串）
SESSION_SECRET=
SESSION_TTL_HOURS=8

# 下载限流（可选——默认 60 次/分钟·IP）
# DOWNLOAD_RATE_LIMIT_WINDOW_MS=60000
# DOWNLOAD_RATE_LIMIT_MAX=60

# label 定义总数上限（可选——默认 100）
# LABEL_MAX_DEFINITIONS=100

# 注册与准入
REGISTRATION_ENABLED=true
ACCESS_POLICY=open

# 对象存储（M1 Local 实现；S3 后置 M3）
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# LDAP 企业通道（默认关闭）
LDAP_ENABLED=false
LDAP_URLS=
LDAP_BIND_MODE=auto
LDAP_USER_BASE=
LDAP_USER_ID_ATTR=sAMAccountName
LDAP_TIMEOUT_MS=5000

# 种子管理员（可选：设置则 db:seed 建 SUPER_ADMIN）
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# 对外基址（OIDC 回调 / Device Flow verificationUri 推导）
PUBLIC_BASE_URL=http://localhost:3000

# OIDC 授权码流（默认关闭；启用需 discovery + clientId/clientSecret，discovery 仅 https）
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 可选：缺省以 PUBLIC_BASE_URL 推导 /api/auth/oidc/callback
OIDC_REDIRECT_URL=
