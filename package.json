{
  "name": "ai-asset-hub",
  "version": "0.1.0",
  "private": true,
  "description": "AI Asset Hub — open-source AI asset registry and marketplace (skill/mcp/agent)",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "db:migrate": "bun run --filter=@ai-asset-hub/server db:migrate",
    "db:seed": "bun run --filter=@ai-asset-hub/server db:seed",
    "db:studio": "bun run --filter=@ai-asset-hub/server db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
